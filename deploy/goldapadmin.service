[Unit]
Description=GoLDAPAdmin - LDAP Directory Management Tool
Documentation=https://github.com/lynnyq/goldapadmin
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# ---- 用户与权限 ----
# 生产环境必须使用非 root 用户运行
User=goldapadmin
Group=goldapadmin

# 工作目录（SQLite 文件和 data/ 相对路径基于此）
WorkingDirectory=/opt/goldapadmin

# 启动命令
ExecStart=/opt/goldapadmin/goldapadmin /opt/goldapadmin/config/config.yaml

# 重启策略: 进程异常退出后自动重启
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=3

# ---- 进程保护（生产安全加固） ----
# 以下选项在 systemd 232+ 可用，最大限度降低进程权限

# 禁止提权
NoNewPrivileges=true

# 限制进程可写路径（只允许工作目录 + 系统日志目录）
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/goldapadmin/data /var/log/goldapadmin

# 禁止访问内核参数和内核日志
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true

# 控制组命名空间隔离
ProtectControlGroups=true
ProtectMounts=true

# 限制网络能力（仅保留必要的）
# ldap:389, ldaps:636 需要 TCP 出站；HTTP 服务本身不需要特殊能力
PrivateTmp=true
PrivateDevices=true

# 限制进程数和文件大小
LimitNOFILE=65536
LimitNPROC=4096
LimitCORE=0

# 安全上下文（如果可用）
ProtectClock=true
ProtectHostname=true
MemoryDenyWriteExecute=true
RestrictRealtime=true

# ---- 日志 ----
# 标准输出/错误写入 systemd journal（go-ldapadmin 自带日志已包含 trace_id）
StandardOutput=journal
StandardError=journal
SyslogIdentifier=goldapadmin

# ---- 健康检查 ----
# GoLDAPAdmin 提供 /api/health 端点，返回 {"status":"ok"}
# systemd 256+ 支持 HTTP GET 健康检查
# 生产环境建议配 Nginx 反代后用 nginx 做 upstream 健康检查
# 这里留空，依赖 systemd 的 Restart=on-failure

[Install]
WantedBy=multi-user.target
