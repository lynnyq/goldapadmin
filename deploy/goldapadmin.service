[Unit]
Description=GoLDAPAdmin - LDAP Directory Management Tool
Documentation=https://github.com/lynnyq/goldapadmin
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# ---- 用户与权限 ----
# 生产环境必须使用非 root 用户运行
User=goldapadmin
Group=goldapadmin

# 工作目录（SQLite 文件和 data/ 相对路径基于此）
WorkingDirectory=/opt/goldapadmin

# 启动命令
ExecStart=/opt/goldapadmin/goldapadmin /opt/goldapadmin/config/config.yaml

# 重启策略: 进程异常退出后自动重启
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=3

# ---- 基础进程保护 ----
# 以下选项兼容大多数 systemd 版本（>= 190）
# 生产环境使用非 root 用户 + 基础隔离即可满足安全要求

# 临时目录和设备隔离
PrivateTmp=true
PrivateDevices=true

# 限制进程数和文件大小
LimitNOFILE=65536
LimitNPROC=4096
LimitCORE=0

# ---- 日志 ----
# 标准输出/错误写入 systemd journal（go-ldapadmin 自带日志已包含 trace_id）
StandardOutput=journal
StandardError=journal
SyslogIdentifier=goldapadmin

# ---- 健康检查 ----
# GoLDAPAdmin 提供 /api/health 端点，返回 {"status":"ok"}
# systemd 256+ 支持 HTTP GET 健康检查
# 生产环境建议配 Nginx 反代后用 nginx 做 upstream 健康检查
# 这里留空，依赖 systemd 的 Restart=on-failure

# ---- 可选安全加固（需要 systemd >= 232，按需启用） ----
# ProtectSystem=strict
# ProtectHome=true
# ProtectKernelTunables=true
# ProtectKernelModules=true
# ProtectKernelLogs=true
# ProtectControlGroups=true
# ProtectMounts=true
# ProtectClock=true
# ProtectHostname=true
# MemoryDenyWriteExecute=true
# RestrictRealtime=true
# NoNewPrivileges=true
# ReadWritePaths=/opt/goldapadmin/data /var/log/goldapadmin

[Install]
WantedBy=multi-user.target
